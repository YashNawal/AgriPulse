# ============================================================================
# KisanMitra Web Environment Variables
# Copy this file to .env.local: cp .env.example .env.local
# ============================================================================

# 1. Supabase Project Credentials (from Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. WhatsApp Bot Number (Used for generating wa.me/ links)
NEXT_PUBLIC_WHATSAPP_BOT_NUMBER=919876543210

# 3. Optional: Backend FastAPI URL (defaults to http://localhost:8000 when running api/)
NEXT_PUBLIC_API_URL=http://localhost:8000

# 4. Optional: Official Agmarknet / Data.gov.in API Key
# Register free at https://data.gov.in to get your personal API Key for live DMI mandi feeds.
# If omitted, AgriPulse automatically operates using the certified regional APMC feed.
DATA_GOV_IN_API_KEY=your-data-gov-in-api-key
NEXT_PUBLIC_DATA_GOV_IN_API_KEY=your-data-gov-in-api-key
